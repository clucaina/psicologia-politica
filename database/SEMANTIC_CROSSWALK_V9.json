      "formula": "(male-female)/male*100",
      "interpretation": "Diferencia no ajustada de medias salariales ANUALES",
      "not_equivalent_to": [
        "Brecha salarial horaria Eurostat",
        "Discriminación causal",
        "Diferencia de salario por mismo puesto"
      ]
    },
    "EAES2024_DIFF_MEDIA_NACIONAL_PCT": {
      "source": "EAES_SALARIO_ANUAL_BRUTO",
      "formula": "(regional_total/national_total-1)*100",
      "interpretation": "Desviación descriptiva de la media anual respecto a España",
      "not_equivalent_to": [
        "Poder adquisitivo",
        "Salario real ajustado por precios",
        "Brecha salarial"
      ]
    }
  },
  "v9_indicators": {
