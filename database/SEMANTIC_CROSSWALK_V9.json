{
  "version": 2,
  "policy": "Never auto-merge conceptually similar series with different methodologies, sources, geographic levels or dates",
  "related_but_not_equivalent": [
    {
      "indicator_ids": [
        "POV_AROPE",
        "ecv_arope_pct"
      ],
      "reason": "Eurostat regional AROPE and INE ECV AROPE may differ by period, territorial treatment and revision. Require human methodology harmonization before a combined timeline."
    },
    {
      "indicator_ids": [
        "DEM_POP",
        "ECP_POP"
      ],
      "reason": "Population snapshots and reference dates can differ; only harmonize with matching period, geography and measurement definition."
    },
    {
      "indicator_ids": [
        "ESTAT_EMP_RATE_NUTS2",
        "EPA_TASA_EMPLEO_25_64_PCT"
      ],
      "reason": "Eurostat T19 empleo 15-64 y Ministerio/EPA T31 empleo 25-64 tienen denominadores distintos; no unir series ni comparar cifras como equivalentes."
    },
    {
      "indicator_ids": [
        "EPA_ABANDONO_TEMPRANO_18_24_PCT",
        "absentismo_escolar",
        "fracaso_escolar"
      ],
      "reason": "Abandono temprano EPA 18-24 mide nivel educativo alcanzado y formación reciente, no asistencia a clase ni titulación ESO."
    },
    {
      "indicator_ids": [
        "EPA_TASA_PARO_25_64_PCT",
        "tasa_paro_general",
        "paro_juvenil"
      ],
      "reason": "La tasa de desempleo 25-64 no es la tasa general ni la juvenil; población de referencia distinta."
    }
  ],
  "no_automatic_inference": [
    "national_to_region",
    "correlation_to_causality",
    "police_records_to_prevalence",
    "convictions_to_reported_crime",
    "screening_to_diagnosis",
    "missing_to_zero",
    "survey_to_census",
    "small_sample_to_precise_ranking",
    "combined_ceuta_melilla_to_separate_geographies",
    "sparse_time_cuts_to_annual_series",
    "education_dropout_to_absenteeism"
  ],
